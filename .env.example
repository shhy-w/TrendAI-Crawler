APP_NAME="TrendAI Crawler"
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=trendai
MYSQL_USER=trendai
MYSQL_PASSWORD=trendai_password
DATABASE_URL=mysql+pymysql://trendai:trendai_password@127.0.0.1:3307/trendai?charset=utf8mb4

CRAWLER_PROFILE_DIR=backend/.playwright-profile
CRAWLER_REQUIRE_LOGIN=false
CRAWLER_CHANNEL=public
CRAWLER_FALLBACK_TO_AUTH=false
CRAWLER_HEADLESS=true
CRAWLER_SCROLL_ROUNDS=6
CRAWLER_SCROLL_PAUSE_MS=1800
CRAWLER_NAVIGATION_TIMEOUT_MS=45000
DEFAULT_KEYWORDS=AI,vibe coding,agent

VITE_API_BASE_URL=http://localhost:8000
